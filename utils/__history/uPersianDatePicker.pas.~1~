unit uPersianDatePicker;

interface

uses
  System.SysUtils, System.Classes, Vcl.Controls, Vcl.StdCtrls, Vcl.Forms;

type
  TPersianDatePicker = class(TCustomControl)
  private
    FYearCombo: TComboBox;
    FMonthCombo: TComboBox;
    FDayCombo: TComboBox;

    FYear: Word;
    FMonth: Word;
    FDay: Word;

    procedure FillYears;
    procedure FillMonths;
    procedure FillDays;

    procedure OnYearChange(Sender: TObject);
    procedure OnMonthChange(Sender: TObject);

    function IsLeapYear(AYear: Word): Boolean;

    procedure SetDate(AValue: TDateTime);
  public
    constructor Create(AOwner: TComponent); override;
    destructor Destroy; override;

    property Date: TDateTime read GetDate write SetDate;
    property Year: Word read FYear write FYear;
    property Month: Word read FMonth write FMonth;
    property Day: Word read FDay write FDay;
  end;

procedure Register;

implementation

uses
  System.SysUtils, System.DateUtils;

{ TPersianDatePicker }

constructor TPersianDatePicker.Create(AOwner: TComponent);
begin
  inherited;
  Width := 300; Height := 25;

  FYearCombo := TComboBox.Create(Self);
  FYearCombo.Parent := Self;
  FYearCombo.Style := csDropDownList;
  FYearCombo.Width := 80;
  FYearCombo.OnChange := OnYearChange;

  FMonthCombo := TComboBox.Create(Self);
  FMonthCombo.Parent := Self;
  FMonthCombo.Style := csDropDownList;
  FMonthCombo.Width := 50;
  FMonthCombo.Left := FYearCombo.Width + 5;
  FMonthCombo.OnChange := OnMonthChange;

  FDayCombo := TComboBox.Create(Self);
  FDayCombo.Parent := Self;
  FDayCombo.Style := csDropDownList;
  FDayCombo.Width := 50;
  FDayCombo.Left := FYearCombo.Width + FMonthCombo.Width + 10;
  FDayCombo.OnChange := OnMonthChange; // same handler to update day list

  FillYears;
  FillMonths;
  FillDays;

  // Default to current Persian date
  SetDate(Now);
end;

destructor TPersianDatePicker.Destroy;
begin
  FYearCombo.Free;
  FMonthCombo.Free;
  FDayCombo.Free;
  inherited;
end;

procedure TPersianDatePicker.FillYears;
var
  Y: Word;
begin
  FYearCombo.Items.Clear;
  for Y := 1320 to 1420 do
    FYearCombo.Items.Add(IntToStr(Y));
  FYearCombo.ItemIndex := 0; // first year by default
end;

procedure TPersianDatePicker.FillMonths;
var
  M: Word;
begin
  FMonthCombo.Items.Clear;
  for M := 1 to 12 do
    FMonthCombo.Items.Add(IntToStr(M));
  FMonthCombo.ItemIndex := 0; // first month by default
end;

procedure TPersianDatePicker.FillDays;
var
  D: Word;
  MaxDay: Word;
begin
  FDayCombo.Items.Clear;
  MaxDay := 31;
  if FMonth >= 7 then
  begin
    if FMonth = 12 then
      MaxDay := 29 + Ord(IsLeapYear(FYear)) // 30 در سال کبیسه
    else
      MaxDay := 30;
  end
  else
    MaxDay := 31;

  for D := 1 to MaxDay do
    FDayCombo.Items.Add(IntToStr(D));
  FDayCombo.ItemIndex := 0; // first day by default
end;

procedure TPersianDatePicker.OnYearChange(Sender: TObject);
begin
  FYear := StrToInt(FYearCombo.Text);
  FillDays; // day list may change due to leap year
end;

procedure TPersianDatePicker.OnMonthChange(Sender: TObject);
begin
  FMonth := StrToInt(FMonthCombo.Text);
  FillDays;
end;

// ساده‌ترین الگوریتم تخمینی برای سال کبیسه‌ی شمسی
function TPersianDatePicker.IsLeapYear(AYear: Word): Boolean;
const
  LeapYears: array[0..11] of Word = (1, 5, 9, 13, 17, 22, 26, 30, 34, 38, 42, 46); // 33‑year cycle
var
  CyclePos: Integer;
begin
  CyclePos := (AYear - 1) mod 33; // 0 .. 32
  Result := (CyclePos = 1) or (CyclePos = 5) or (CyclePos = 9) or
            (CyclePos = 13) or (CyclePos = 17) or (CyclePos = 22) or
            (CyclePos = 26) or (CyclePos = 30);
end;

procedure TPersianDatePicker.SetDate(AValue: TDateTime);
var
  J: TDateTime;
  Y, M, D: Word;
begin
  // تبدیل Gregorian به Jalaali (شمسی) از طریق تابع موجود
  J := AValue; // اینجا می‌توانید از کتابخانه‌ی Jalaali استفاده کنید
  J := System.DateUtils.DateToJalaali(J, Y, M, D); // فرض بر وجود تابع
  FYearCombo.ItemIndex := Y - 1320;
  FMonthCombo.ItemIndex := M - 1;
  FDayCombo.ItemIndex := D - 1;
end;

function TPersianDatePicker.GetDate: TDateTime;
var
  Y, M, D: Word;
begin
  Y := StrToInt(FYearCombo.Text);
  M := StrToInt(FMonthCombo.Text);
  D := StrToInt(FDayCombo.Text);
  Result := System.DateUtils.JalaaliToDate(Y, M, D); // تابع تبدیل برعکس
end;

procedure Register;
begin
  RegisterComponents('Persian', [TPersianDatePicker]);
end;

end.
