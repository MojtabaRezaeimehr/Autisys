unit dmEvents;

interface

uses
  System.SysUtils, System.Classes, dmServer, FireDAC.Stan.Intf,
  FireDAC.Stan.Option, FireDAC.Stan.Param, FireDAC.Stan.Error, FireDAC.DatS,
  FireDAC.Phys.Intf, FireDAC.DApt.Intf, FireDAC.Stan.Async, FireDAC.DApt,
  Data.DB, FireDAC.Comp.DataSet, FireDAC.Comp.Client;

type
  TdmEvents_ = class(TDataModule)
    dsEvents: TDataSource;
    fQryEvents: TFDQuery;
    procedure DataModuleCreate(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  dmEvents_: TdmEvents_;

implementation

{%CLASSGROUP 'FMX.Controls.TControl'}
{$R *.dfm}

procedure TdmEvents_.DataModuleCreate(Sender: TObject);
var
  i: integer;
begin
  for i := 0 to ComponentCount do
  begin
    if Components[i] is TFDQuery then
      (Components[i] as TFDQuery).Active := true;
  end;
end;

end.
