unit uLogin;

interface

uses
  System.SysUtils, System.Types, System.UITypes, System.Classes, System.Variants,
  FMX.Types, FMX.Controls, FMX.Forms, FMX.Graphics, FMX.Dialogs, FMX.StdCtrls,
  FMX.Layouts, FMX.Controls.Presentation, FMX.Edit;

type
  TfLogin = class(TForm)
    Panel1: TPanel;
    Panel2: TPanel;
    Panel3: TPanel;
    GridPanelLayout1: TGridPanelLayout;
    btnExit: TButton;
    btnLogin: TButton;
    Label1: TLabel;
    Label2: TLabel;
    eUserName: TEdit;
    Edit2: TEdit;
    procedure btnExitClick(Sender: TObject);
    procedure btnLoginClick(Sender: TObject);
  private
    { Private declarations }
  public
    { Public declarations }
  end;

var
  fLogin: TfLogin;

implementation

{$R *.fmx}

uses Main;

procedure TfLogin.btnExitClick(Sender: TObject);
begin
  Application.Terminate;
end;

procedure TfLogin.btnLoginClick(Sender: TObject);
var fMainScreen:TfMainScreen;
begin
  fMainScreen:=TfMainScreen.Create(self);
  with fMainScreen do
  begin
    ShowModal;
    Free;
  end;
end;

end.
